# Vorlage – als .env kopieren und anpassen. Die .env gehört nie ins Git.

# Adresse, unter der die Nutzer die App im Browser sehen (die des Reverse Proxys), ohne Schrägstrich am Ende.
# Daraus ergeben sich die Umleitungs-URI für Entra und ob Cookies nur über HTTPS gesendet werden.
APP_URL=http://localhost:3000

# Port, Schnittstelle und Datenordner – nur ohne Docker von Bedeutung.
# Mit Docker sind diese drei Werte fest; den Port außen bestimmt die Compose-Datei.
PORT=3000
HOST=0.0.0.0
DATA_DIR=./data

# Ordner mit gepflegten Inhalten (Schulferien je Bundesland); mit Docker fest
CONTENT_DIR=./content
# Ordner mit Lerninhalten für das Lernmodul: ein Unterordner je Inhaltspaket (siehe lerninhalte/README.md)
LERN_DIR=./lerninhalte

# Anmeldung über Microsoft Entra ID (Anleitung: docs/entra-einrichtung.md).
# Ohne diese Werte kann sich nur der Super-Admin anmelden.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Nur für den allerersten Start: Zugangsdaten des Super-Admins.
# Leer lassen, dann heißt er "admin" und das Startpasswort steht einmalig im Log
# (mit Docker: docker compose logs app).
# Nach dem ersten Start wieder entfernen.
ADMIN_BENUTZER=
ADMIN_PASSWORT=

# true, wenn die App hinter einem Reverse Proxy läuft (Client-IP aus X-Forwarded-For).
# Mit Docker hinter einem Proxy immer true – sonst sehen alle Nutzer für die App wie eine einzige Adresse aus.
TRUST_PROXY=false

# Benachrichtigung in Microsoft Teams, sobald im Portal ein Fehler gemeldet wird (freiwillig).
# Adresse eines Teams-Workflows mit dem Auslöser „Beim Empfang einer Teams-Webhookanforderung“ (Anleitung: README).
# Die Adresse ist ein Geheimnis: Wer sie kennt, kann in den Kanal schreiben.
# Gesendet werden Nummer, Rolle, Seite und ein Link ins Portal – kein Name, kein Bild.
FEHLER_WEBHOOK_URL=
# true: auch den Text der Meldung mitschicken. Nur einschalten, wenn alle im Kanal ihn lesen dürfen.
FEHLER_WEBHOOK_MIT_TEXT=false

# Nur zum Entwickeln: Anmeldung als vorhandenes Entra-Konto ohne Entra. Wird in Produktion ignoriert.
DEV_ANMELDUNG=false
